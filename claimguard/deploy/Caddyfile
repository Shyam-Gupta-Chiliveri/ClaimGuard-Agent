# APP_DOMAIN / N8N_DOMAIN come from .env.
# With real domains Caddy gets Let's Encrypt certificates automatically.
# For an IP-only server set APP_DOMAIN=:80 and N8N_DOMAIN=:8080 (and open 8080 in the firewall).

{$APP_DOMAIN::80} {
	encode zstd gzip
	reverse_proxy app:8000 {
		flush_interval -1
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$N8N_DOMAIN::8080} {
	encode zstd gzip
	reverse_proxy n8n:5678
}
