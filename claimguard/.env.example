# ---- public addresses -------------------------------------------------------
# With a domain (DNS A records pointing at the server): automatic HTTPS
#   APP_DOMAIN=claimguard.example.com
#   N8N_DOMAIN=n8n.claimguard.example.com
#   N8N_PUBLIC_URL=https://n8n.claimguard.example.com/
# IP only (no HTTPS):
APP_DOMAIN=:80
N8N_DOMAIN=:8080
N8N_PUBLIC_URL=http://YOUR_SERVER_IP:8080/
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# ---- agent LLM (optional; without it the agent uses its offline planner) ----
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Ollama (compose profile "llm"): LLM_BASE_URL=http://ollama:11434/v1  LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- n8n workflows -----------------------------------------------------------
# Incoming-webhook URL of a Slack / Teams / Discord channel for alerts
ALERT_WEBHOOK_URL=
# For the weekly drift workflow to trigger a CI retrain: owner/repo and a fine-grained token (actions: write)
GITHUB_REPO=
GITHUB_TOKEN=

# ---- API ---------------------------------------------------------------------
CORS_ORIGINS=*
